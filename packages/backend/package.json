{
  "name": "@svej/backend",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-2.0",
  "scripts": {
    "start": "tsx --env-file=../../.env ./index.ts",
    "watch": "tsx watch --env-file=../../.env ./index.ts",
    "test": "dotenv -e ../../.env jest ./tests --passWithNoTests",
    "format:check": "prettier -c \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "yarn lint --fix",
    "ts:check": "tsc --noEmit",
    "check": "yarn format && yarn format:check && yarn lint && yarn ts:check"
  },
  "dependencies": {
    "@elysia/node": "^1.4.6",
    "@sinclair/typebox": "^0.34.49",
    "@svej/common": "workspace:*",
    "@svej/database": "workspace:*",
    "@svej/file-system": "workspace:*",
    "@svej/server-side": "workspace:*",
    "blurhash": "^2.0.5",
    "cross-spawn": "^7.0.3",
    "debug": "^4.3.4",
    "dedent": "^0.7.0",
    "dotenv": "^16.1.3",
    "elysia": "^1.4.28",
    "file-type": "^22.0.1",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "openapi-types": "^12.1.3",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.2",
    "@types/debug": "^4.1.8",
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^27.4.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.9.1",
    "debug": "^4.3.4",
    "dotenv-cli": "^7.2.1",
    "eslint": "9.39.3",
    "eslint-import-resolver-typescript": "^4.4.5",
    "jest": "^27.5.1",
    "rimraf": "^3.0.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}

{
  "name": "chat",
  "description": "Created with project-manager CLI",
  "private": true,
  "version": "1.0.0",
  "main": "./exports.ts",
  "types": "./exports.ts",
  "scripts": {
    "start": "tsx --env-file=../../.env ./index.ts",
    "watch": "tsx watch --env-file=../../.env ./index.ts",
    "test": "dotenv -e ../../.env jest ./tests --passWithNoTests",
    "format:check": "prettier -c \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "yarn lint --fix",
    "ts:check": "tsc --noEmit",
    "check": "yarn format && yarn format:check && yarn lint && yarn ts:check"
  },
  "dependencies": {
    "common": "workspace:*",
    "database": "workspace:*",
    "dotenv": "^16.4.5",
    "server-side": "workspace:*",
    "socket.io": "^4.7.4",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.0",
    "@types/jest": "^27.4.1",
    "@types/node": "^20.2.5",
    "dotenv-cli": "^7.2.1",
    "eslint": "9.39.3",
    "jest": "^27.5.1",
    "rimraf": "^5.0.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}

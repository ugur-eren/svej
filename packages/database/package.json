{
  "name": "@svej/database",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-2.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./enums": {
      "import": "./enums.ts",
      "require": "./enums.ts"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env prisma generate",
    "db:push": "dotenv -e ../../.env prisma db push --skip-generate",
    "db:studio": "dotenv -e ../../.env prisma studio",
    "db:seed": "dotenv -e ../../.env prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.1.3",
    "dotenv-cli": "^7.2.1",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}

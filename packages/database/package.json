{
  "name": "@svej/database",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-2.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "db:generate": "dotenv -e ../../.env prisma generate",
    "db:push": "dotenv -e ../../.env prisma db push --skip-generate",
    "db:studio": "dotenv -e ../../.env prisma studio",
    "db:seed": "tsx --env-file=../../.env ./seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv-cli": "^7.2.1",
    "prisma": "6.19.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  }
}

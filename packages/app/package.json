  "main": "./index.js",
  "scripts": {
    "start": "dotenv -e ../../.env expo start",
    "android": "dotenv -e ../../.env expo run:android",
    "ios": "dotenv -e ../../.env expo run:ios",
    "prebuild": "dotenv -e ../../.env expo prebuild",
    "prebuild:clean": "yarn run prebuild -- --clean",
    "web": "dotenv -e ../../.env expo start --web",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "yarn lint --fix",
    "format:check": "prettier -c \"src/**/*.{ts,tsx}\"",
    "ts:check": "tsc --noEmit",
    "check": "yarn format && yarn format:check && yarn lint && yarn ts:check"
  },

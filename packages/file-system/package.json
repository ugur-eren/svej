{
  "name": "@svej/file-system",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "format:check": "prettier -c \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint:check": "eslint \"src/**/*.ts\"",
    "lint": "yarn lint:check --fix",
    "ts:check": "tsc --noEmit",
    "check": "yarn format && yarn format:check && yarn lint:check && yarn ts:check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@google-cloud/storage": "^7.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "eslint": "9.39.3",
    "typescript": "~6.0.3"
  }
}
